{
  "name": "skillwise_aitutor",
  "version": "1.0.0",
  "description": "SkillWise AI Tutor - An intelligent tutoring system",
  "license": "ISC",
  "main": "index.js",
  "scripts": {
    "dev:all": "docker-compose up -d && echo '🟡 Installing dependencies inside containers...' && docker-compose exec backend sh -c 'npm install' && docker-compose exec frontend sh -c 'npm install' && echo '✅ All services are ready! Frontend: http://localhost:3000 | Backend: http://localhost:3001/api'",
    "down": "docker-compose down -v",
    "logs": "docker-compose logs -f",
    "logs:backend": "docker-compose logs -f backend",
    "logs:frontend": "docker-compose logs -f frontend",
    "logs:db": "docker-compose logs -f database",
    "build": "docker-compose build",
    "rebuild": "docker-compose build --no-cache",
    "reset": "docker-compose down -v && docker-compose up -d",
    "prepare": "husky install",
    "lint": "eslint . --ext .js,.jsx --max-warnings=999",
    "test": "cd backend && npm test -- --ci --runInBand",
    "test:unit": "npm run test",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "start": "cd frontend && npm start"
  },
  "keywords": [
    "ai",
    "tutor",
    "education",
    "react",
    "node",
    "postgresql"
  ],
  "devDependencies": {
    "cypress": "^15.6.0",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^2.12.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "prettier": "^2.8.8",
    "sass": "^1.93.2"
  },
  "dependencies": {
    "multer": "^2.0.2"
  }
}
